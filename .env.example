# Sao chép file này thành .env rồi điền khoá thật
# ---------------------------------------------------

# Khoá API OpenAI. Bỏ trống -> hệ thống chạy ở CHẾ ĐỘ NGOẠI TUYẾN (phản biện bằng
# mẫu dựng sẵn từ ngữ liệu, chỉ để demo luồng, chất lượng thấp).
OPENAI_API_KEY=

# Model chat: chọn bản rẻ. gpt-4o-mini là mặc định (rẻ, đủ dùng cho phản biện).
CHAT_MODEL=gpt-4o-mini

# Bộ chạy tác tử: native (gọi thẳng OpenAI) hoặc crewai (dựng Agent/Task/Crew).
# Chọn crewai thì phải cài thêm: pip install -r requirements-crewai.txt
AGENT_FRAMEWORK=native

# Gán model riêng cho từng vai (bỏ trống thì dùng CHAT_MODEL ở trên).
# Cho trọng tài chạy model khác người phản biện sẽ giảm thiên vị khi chấm.
# QUESTION_MODEL=
# DEBATER_MODEL=
# JUDGE_MODEL=

# Model embedding cho RAG (text-embedding-3-small là bản rẻ nhất của OpenAI)
EMBED_MODEL=text-embedding-3-small

# Số đoạn ngữ liệu lấy về mỗi lần truy hồi
TOP_K=4

# Số vòng phản biện qua lại
MAX_ROUNDS=3

# Số ngày giữ phiên đăng nhập (tính từ lần hoạt động cuối)
SESSION_TTL_DAYS=7

# Tài khoản được phép mở trang "Tài liệu nguồn" (nạp lại học liệu).
# Nhiều email thì cách nhau bằng dấu phẩy.
ADMIN_EMAILS=admin@gmail.com

# Nhiệt độ sinh văn bản
LLM_TEMPERATURE=0.4

# Đường dẫn CSDL SQLite (mặc định data/app.db)
# DB_PATH=data/app.db
